+	dwc3_qcom_setbits(csr, USB2PHY_USB_PHY_PWRDOWN_CTRL, USB2PHY_PWRDN_B);
+	dwc3_qcom_setbits(csr, USB2PHY_USB_PHY_REFCLK_CTRL,
