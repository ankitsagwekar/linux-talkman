++++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+@@ -85,7 +85,7 @@ camfocus-key {
+ 			label = "Camera Focus";
+ 			gpios = <&pm8994_gpios 5 GPIO_ACTIVE_LOW>;
+ 			linux,input-type = <1>;
+-			linux,code = <KEY_VOLUMEUP>;
++			linux,code = <KEY_CAMERA_FOCUS>;
+ 			wakeup-source;
+ 			debounce-interval = <15>;
+ 		};
+@@ -101,7 +101,7 @@ gpio-hall-sensor {
+ 
+ 		event-hall-front-sensor {
+ 			label = "Hall Effect Front Sensor";
+-			gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
++			gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
+ 			linux,input-type = <EV_SW>;
+ 			linux,code = <SW_LID>;
+ 			linux,can-disable;
+@@ -109,7 +109,7 @@ event-hall-front-sensor {
+ 
+ 		event-hall-back-sensor {
+ 			label = "Hall Effect Back Sensor";
+-			gpios = <&tlmm 75 GPIO_ACTIVE_HIGH>;
++			gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
+ 			linux,input-type = <EV_SW>;
+ 			linux,code = <SW_MACHINE_COVER>;
+ 			linux,can-disable;
