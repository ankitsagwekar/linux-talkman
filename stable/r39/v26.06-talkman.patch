diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0009-usb-dwc3-qcom-legacy-init-MSM8994-SNPS-HS-PHY.patch b/device/testing/linux-postmarketos-qcom-msm8994/0009-usb-dwc3-qcom-legacy-init-MSM8994-SNPS-HS-PHY.patch
new file mode 100644
index 0000000000..8dadbd0c46
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0009-usb-dwc3-qcom-legacy-init-MSM8994-SNPS-HS-PHY.patch
@@ -0,0 +1,153 @@
+From: Ankit <ankits@outlook.sg>
+Subject: [PATCH] usb: dwc3: qcom-legacy: init MSM8994 SNPS HS PHY, enable D+ pull-up
+
+MSM8994/8992 have a Synopsys USB2 PHY controlled through QSCRATCH, with
+no mainline PHY driver. When the bootloader leaves USB untouched (Lumia
+UEFI), the UDC stays "not attached": the PHY is not set up and the D+
+pull-up (VBUSVLDEXT0, with VBUSVLDEXTSEL0) is never enabled.
+
+When "qcom,hsphy-init" is present, run the downstream phy-msm-hsusb.c init
+sequence and also drive VBUSVLDEXT0/VBUSVLDEXTSEL0 with the VBUS override.
+Set the Lumia device-mode tuning value in the Octagon DT.
+---
+diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+index 3060896..e3475b6 100644
+--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
++++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+@@ -906,6 +906,15 @@ &sdhc2 {
+  * Peripheral only for now, as in the Android4Lumia950/EpicLPer trees where
+  * the USB gadget is known to work. Host mode via the UC120 comes later.
+  */
++&usb3 {
++	/*
++	 * Lumia device-mode USB2 PHY tuning (downstream msm8992-chi.dtsi
++	 * &hsphy0 qcom,hsphy-init). Also makes the glue initialise the PHY
++	 * and drive the D+ pull-up (VBUSVLDEXT0).
++	 */
++	qcom,hsphy-init = <0x00d1d9a4>;
++};
++
+ &usb3_dwc3 {
+ 	dr_mode = "peripheral";
+ };
+diff --git a/drivers/usb/dwc3/dwc3-qcom-legacy.c b/drivers/usb/dwc3/dwc3-qcom-legacy.c
+index d3fad0f..0afd787 100644
+--- a/drivers/usb/dwc3/dwc3-qcom-legacy.c
++++ b/drivers/usb/dwc3/dwc3-qcom-legacy.c
+@@ -29,6 +29,30 @@
+ #define UTMI_OTG_VBUS_VALID			BIT(20)
+ #define SW_SESSVLD_SEL				BIT(28)
+ 
++/*
++ * MSM8994/MSM8992 integrated Synopsys USB2 PHY, controlled through QSCRATCH.
++ * Mainline has no PHY driver for it; on bootloaders that do not bring USB
++ * up (e.g. Lumia UEFI) the PHY must be initialised here, following the
++ * downstream phy-msm-hsusb.c sequence.
++ */
++#define HSPHY_RETENABLEN			BIT(1)
++#define HSPHY_VBUSVLDEXT0			BIT(13)	/* D+ pull-up */
++#define HSPHY_USB2_UTMI_CLK_EN			BIT(21)
++#define HSPHY_USB2_SUSPEND_N_SEL		BIT(23)
++#define HSPHY_CLAMP_MPM_DPSE_DMSE_EN_N		BIT(26)
++#define QSCRATCH_PARAMETER_OVERRIDE_X		0x14
++#define HSPHY_PARAM_MASK			0x03ffffff
++#define QSCRATCH_HS_PHY_CTRL_COMMON		0xec
++#define HSPHY_COMMON_RETENABLEN			BIT(3)
++#define HSPHY_COMMON_FSEL			(0x7 << 4)
++#define HSPHY_COMMON_COMMONONN			BIT(7)
++#define HSPHY_COMMON_OTGTUNE0_MASK		(0x7 << 8)
++#define HSPHY_COMMON_OTGTUNE0_DEFAULT		(0x4 << 8)
++#define HSPHY_COMMON_OTGDISABLE0		BIT(11)
++#define HSPHY_COMMON_VBUSVLDEXTSEL0		BIT(12)
++#define HSPHY_COMMON_CLKCORE			BIT(14)
++#define HSPHY_COMMON_PLLBTUNE			BIT(15)
++
+ #define QSCRATCH_SS_PHY_CTRL			0x30
+ #define LANE0_PWR_PRESENT			BIT(24)
+ 
+@@ -86,6 +110,7 @@ struct dwc3_qcom {
+ 	struct notifier_block	host_nb;
+ 
+ 	enum usb_dr_mode	mode;
++	bool			snps_hsphy;
+ 	bool			is_suspended;
+ 	bool			pm_suspended;
+ 	struct icc_path		*icc_path_ddr;
+@@ -119,18 +144,58 @@ static inline void dwc3_qcom_clrbits(void __iomem *base, u32 offset, u32 val)
+ static void dwc3_qcom_vbus_override_enable(struct dwc3_qcom *qcom, bool enable)
+ {
+ 	if (enable) {
++		if (qcom->snps_hsphy)
++			dwc3_qcom_setbits(qcom->qscratch_base,
++					  QSCRATCH_HS_PHY_CTRL_COMMON,
++					  HSPHY_COMMON_VBUSVLDEXTSEL0);
+ 		dwc3_qcom_setbits(qcom->qscratch_base, QSCRATCH_SS_PHY_CTRL,
+ 				  LANE0_PWR_PRESENT);
+ 		dwc3_qcom_setbits(qcom->qscratch_base, QSCRATCH_HS_PHY_CTRL,
+-				  UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL);
++				  UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL |
++				  (qcom->snps_hsphy ? HSPHY_VBUSVLDEXT0 : 0));
+ 	} else {
+ 		dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_SS_PHY_CTRL,
+ 				  LANE0_PWR_PRESENT);
+ 		dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_HS_PHY_CTRL,
+-				  UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL);
++				  UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL |
++				  (qcom->snps_hsphy ? HSPHY_VBUSVLDEXT0 : 0));
+ 	}
+ }
+ 
++/* Downstream phy-msm-hsusb.c msm_hsphy_init() + resume, device mode */
++static void dwc3_qcom_snps_hsphy_init(struct dwc3_qcom *qcom, u32 init_seq)
++{
++	void __iomem *base = qcom->qscratch_base;
++	u32 val;
++
++	/* Enable UTMI clock, clamp HV interrupts, leave retention */
++	val = readl(base + QSCRATCH_HS_PHY_CTRL);
++	val |= HSPHY_USB2_UTMI_CLK_EN | HSPHY_CLAMP_MPM_DPSE_DMSE_EN_N |
++	       HSPHY_RETENABLEN;
++	/* Let the controller drive suspend_n (PHY out of suspend) */
++	val &= ~HSPHY_USB2_SUSPEND_N_SEL;
++	writel(val, base + QSCRATCH_HS_PHY_CTRL);
++	usleep_range(2000, 2200);
++
++	val = readl(base + QSCRATCH_HS_PHY_CTRL_COMMON);
++	val &= ~(HSPHY_COMMON_OTGTUNE0_MASK | HSPHY_COMMON_FSEL |
++		 HSPHY_COMMON_OTGDISABLE0);
++	val |= HSPHY_COMMON_OTGTUNE0_DEFAULT | HSPHY_COMMON_COMMONONN |
++	       HSPHY_COMMON_RETENABLEN | HSPHY_COMMON_PLLBTUNE |
++	       HSPHY_COMMON_CLKCORE;
++	writel(val, base + QSCRATCH_HS_PHY_CTRL_COMMON);
++
++	val = readl(base + QSCRATCH_PARAMETER_OVERRIDE_X);
++	val &= ~HSPHY_PARAM_MASK;
++	val |= init_seq & HSPHY_PARAM_MASK;
++	writel(val, base + QSCRATCH_PARAMETER_OVERRIDE_X);
++	readl(base + QSCRATCH_PARAMETER_OVERRIDE_X);
++
++	dev_info(qcom->dev, "SNPS HS PHY init 0x%08x, HS_PHY_CTRL 0x%08x, COMMON 0x%08x\n",
++		 init_seq, readl(base + QSCRATCH_HS_PHY_CTRL),
++		 readl(base + QSCRATCH_HS_PHY_CTRL_COMMON));
++}
++
+ static int dwc3_qcom_vbus_notifier(struct notifier_block *nb,
+ 				   unsigned long event, void *ptr)
+ {
+@@ -793,6 +858,16 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
+ 	if (ignore_pipe_clk)
+ 		dwc3_qcom_select_utmi_clk(qcom);
+ 
++	{
++		u32 hsphy_init;
++
++		if (!device_property_read_u32(dev, "qcom,hsphy-init",
++					      &hsphy_init)) {
++			qcom->snps_hsphy = true;
++			dwc3_qcom_snps_hsphy_init(qcom, hsphy_init);
++		}
++	}
++
+ 	ret = dwc3_qcom_of_register_core(pdev);
+ 	if (ret) {
+ 		dev_err(dev, "failed to register DWC3 Core, err=%d\n", ret);
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0010-lumia-octagon-MSM8994-PCIe-QCA6174A-WiFi.patch b/device/testing/linux-postmarketos-qcom-msm8994/0010-lumia-octagon-MSM8994-PCIe-QCA6174A-WiFi.patch
new file mode 100644
index 0000000000..36f9fa15ce
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0010-lumia-octagon-MSM8994-PCIe-QCA6174A-WiFi.patch
@@ -0,0 +1,1553 @@
+From: Stefan (EpicLPer) / Ankit <ankits@outlook.sg>
+Subject: [PATCH] lumia-octagon: MSM8994/8992 PCIe RC + QCA6174A Wi-Fi
+
+Backport of EpicLPer/linux commits 7bedb9e313 and 003190c3e3 (PCIe DWC
+support for qcom,pcie-msm8994, 20nm QMP PCIe PHY driver, gcc pipe/aux
+parents, ECRC opt-out, QCA6174A power and pin setup) to 6.16, verified
+upstream on a Lumia 950 XL.
+
+Talkman (MSM8992) additions:
+- enable RC0 (pcie0) with the 8992 pins TLMM 35/36/37 (pcie1_default
+  group), as in downstream msm8992-pinctrl.dtsi;
+- toggle the right block reset per RC (GCC_PCIE_0_BCR 0x1ac0 for RC0,
+  GCC_PCIE_1_BCR 0x1b40 for RC1) instead of always PCIe1;
+- pwrseq-qcom-wcn changes dropped (no consumer, needs newer pwrseq API).
+---
+diff --git a/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts b/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts
+index db3c4d4b1..a6370aa3b 100644
+--- a/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts
++++ b/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts
+@@ -35,3 +35,26 @@ &pmi8994_smbchg {
+ &uc120 {
+ 	vbus-supply = <&pmi8994_otg>;
+ };
++
++/*
++ * QCA6174A Wi-Fi on PCIe RC0. On MSM8992 RC0 uses TLMM 35/36/37 (PERST#,
++ * CLKREQ# as pci_e1 mux, WAKE#), i.e. the pins named pcie1_default here
++ * (downstream msm8992-pinctrl.dtsi pcie0_*). Supplies as on Cityman RC1.
++ */
++&pciephy0 {
++	status = "okay";
++};
++
++&pcie0 {
++	status = "okay";
++	pinctrl-names = "default";
++	pinctrl-0 = <&pcie1_default &wlan_bootstrap_default>;
++	vdda-supply = <&vreg_l28a_1p0>;
++	vddpe-3v3-supply = <&wlan_en>;
++	qcom,no-ecrc;
++	wake-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
++
++	pcie@0 {
++		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
++	};
++};
+diff --git a/arch/arm64/boot/dts/qcom/msm8992.dtsi b/arch/arm64/boot/dts/qcom/msm8992.dtsi
+index b2dc46c25..b744732f7 100644
+--- a/arch/arm64/boot/dts/qcom/msm8992.dtsi
++++ b/arch/arm64/boot/dts/qcom/msm8992.dtsi
+@@ -13,8 +13,14 @@
+ 
+ &gcc {
+ 	compatible = "qcom,gcc-msm8992";
++	clock-names = "xo", "sleep", "pcie_0_pipe";
++	clocks = <&xo_board>, <&sleep_clk>, <&pciephy0>;
+ };
+ 
++/* 8992 has no PCIe1. Cityman WiFi is 8994 pcie1. */
++/delete-node/ &pcie1;
++/delete-node/ &pciephy1;
++
+ &mmcc {
+ 	compatible = "qcom,mmcc-msm8992";
+ 
+diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts
+index c59341820..10e4d27a2 100644
+--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts
++++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts
+@@ -14,3 +14,52 @@ / {
+ 	compatible = "microsoft,cityman", "qcom,msm8994";
+ 	chassis-type = "handset";
+ };
++
++&pciephy1 {
++	status = "okay";
++	vdda-supply = <&vreg_l12a_1p8>;
++};
++
++&pcie1 {
++	status = "okay";
++	pinctrl-names = "default";
++	/*
++	 * `pcie1_default` also carries the CNSS bootstrap pin (TLMM 112): it is
++	 * applied before ops->init() raises WLAN_EN, so the endpoint sees the
++	 * vendor's order (bootstrap high -> >=10 ms -> WLAN_EN -> RC bring-up).
++	 */
++	pinctrl-0 = <&pcie1_default &wlan_bootstrap_default>;
++	vdda-supply = <&vreg_l28a_1p0>;
++	vddpe-3v3-supply = <&wlan_en>;
++
++	/*
++	 * Do not let the DWC ATU force a TLP Digest (ECRC) onto outgoing TLPs.
++	 * On cores older than 5.10A the ATU 'TD' bit overrides the ECRC setting,
++	 * so mainline appends a TLP Digest to every TLP the ATU translates. The
++	 * vendor 3.10 stack never programs it: its live dump reads
++	 * iATU CTRL1 = 0x00000004 (transaction type only) where mainline reads
++	 * 0x00000104, and on an EP that enumerates the difference is real. 3.10
++	 * has no ECRC/TD handling in its DWC at all.
++	 */
++	qcom,no-ecrc;
++
++	/*
++	 * 3.10 pci-msm has `wake-gpio = <&msm_gpio 37 0>` on this node and
++	 * requests it as a falling-edge IRQ ("msm_pcie_wake"). The Lumia DT
++	 * deletes `qcom,ep-wakeirq` (msm8994-chi.dtsi), so enumeration is not
++	 * gated on it there - but the line is wired and worth watching:
++	 * asserted (low) means the endpoint wants the host's attention.
++	 */
++	wake-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
++
++	/*
++	 * PERST# is an endpoint property and belongs on the port node:
++	 * with `perst-gpios` on the Root Complex, qcom_pcie_parse_perst()
++	 * falls back to it and warns "DT needs to be fixed!" instead of
++	 * driving the port's own reset-gpios.
++	 */
++	pcie@0 {
++		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
++	};
++};
++
+diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+index e3475b69f..a5ca16aa8 100644
+--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
++++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+@@ -59,6 +59,59 @@ divclk4: divclk4 {
+ 		};
+ 	};
+ 
++	/*
++	 * QCA6174 as a power-sequencing provider (models the WLAN PMU via
++	 * pwrseq-qcom-wcn). The discrete
++	 * Rome chip is powered by the PCIe PHY rail (vdda), the module enable
++	 * line (vddpe-3v3 = wlan_en), and clocked by the 32.768 kHz sleep clock
++	 * (divclk4). The provider enables them in order before the RC is trained.
++	 */
++	wcn_pmu: power-sequencer {
++		compatible = "qcom,qca6174-pmu";
++		vdda-supply = <&vreg_l28a_1p0>;
++		vddpe-3v3-supply = <&wlan_en>;
++		clocks = <&divclk4>;
++		#power-domain-cells = <0>;
++	};
++
++	/*
++	 * 3.10 bt_vreg / wlan_vreg share PM8994 GPIO 9
++	 * (WLAN_LDO_3V_CTRL). QCA6174 chip enable is TLMM 113.
++	 */
++	wlan_vreg: wlan-vreg {
++		compatible = "regulator-fixed";
++		regulator-name = "wlan-vreg";
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		gpio = <&pm8994_gpios 9 GPIO_ACTIVE_HIGH>;
++		enable-active-high;
++		startup-delay-us = <4000>;
++		/*
++		 * This pin is the enable of the module's 3.3 V LDO (vendor name
++		 * `bt-vdd-pa`/`vdd-wlan`). The vendor DT configures PM8994 GPIO 9
++		 * with `vin-sel = PM8994_GPIO_VPH` (it is the only output in that
++		 * node not using vin-sel=<2>); without an explicit pin state
++		 * mainline keeps the firmware's VIN2 (1.8 V) source, which can
++		 * leave the LDO's EN threshold unmet.
++		 */
++		pinctrl-names = "default";
++		pinctrl-0 = <&wlan_vreg_default &wlan_clk_default>;
++	};
++
++	wlan_en: wlan-en {
++		compatible = "regulator-fixed";
++		regulator-name = "wlan-en";
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		gpio = <&tlmm 113 GPIO_ACTIVE_HIGH>;
++		vin-supply = <&wlan_vreg>;
++		enable-active-high;
++		pinctrl-names = "default";
++		pinctrl-0 = <&wlan_en_default>;
++		/* match the working msm8996-xiaomi-common QCA6174a wlan_en delay */
++		startup-delay-us = <70000>;
++	};
++
+ 	gpio-keys {
+ 		compatible = "gpio-keys";
+ 		autorepeat;
+@@ -497,6 +550,33 @@ qca6174_bt: bluetooth {
+ };
+ 
+ &pm8994_gpios {
++	wlan_vreg_default: wlan-vreg-state {
++		pinconf {
++			pins = "gpio9";
++			function = PMIC_GPIO_FUNC_NORMAL;
++			power-source = <PM8994_GPIO_VPH>;
++			bias-disable;
++		};
++	};
++
++	/*
++	 * PM8994 GPIO 18 = DIVCLK4 = the 32.768 kHz sleep clock fed to the
++	 * QCA6174. The `divclk4` fixed-clock node declares pinctrl-0 =
++	 * <&divclk4_pin_a>, but `fixed-clock` is registered by
++	 * CLK_OF_DECLARE and clk-fixed-rate.c contains no pinctrl handling at
++	 * all, so that state is never applied and the pin keeps whatever
++	 * firmware left. This group is attached to wlan-vreg (a real platform
++	 * device) so that it actually gets programmed.
++	 */
++	wlan_clk_default: wlan-clk-state {
++		pinconf {
++			pins = "gpio18";
++			function = PMIC_GPIO_FUNC_FUNC2;
++			power-source = <PM8994_GPIO_S4>;
++			bias-disable;
++		};
++	};
++
+ 	bt_en_gpios: bt-en-gpios-state {
+ 		pinconf {
+ 			pins = "gpio19";
+@@ -509,10 +589,17 @@ pinconf {
+ 	};
+ 
+ 	divclk4_pin_a: divclk4-state {
++		/*
++		 * Vendor GPIO18 (DIVCLK4) config: FUNC2, VIN2, medium drive,
++		 * output enabled, so the PMIC divider really outputs the
++		 * 32.768 kHz sleep clock the QCA6174 (Wi-Fi and BT) need.
++		 */
+ 		pinconf {
+ 			pins = "gpio18";
+ 			function = PMIC_GPIO_FUNC_FUNC2;
+ 			power-source = <PM8994_GPIO_S4>;
++			qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
++			output-low;
+ 			bias-disable;
+ 		};
+ 	};
+@@ -604,6 +691,8 @@ vreg_s3a_1p3: s3 {
+ 			regulator-max-microvolt = <1300000>;
+ 			regulator-allow-set-load;
+ 			regulator-system-load = <300000>;
++			/* required by QCA6174a vdd-core */
++			regulator-always-on;
+ 		};
+ 
+ 		vreg_s4a_1p8: s4 {
+@@ -678,6 +767,7 @@ vreg_l8a_1p8: l8 {
+ 		vreg_l9a_1p8: l9 {
+ 			regulator-min-microvolt = <1800000>;
+ 			regulator-max-microvolt = <1800000>;
++
+ 		};
+ 
+ 		vreg_l10a_1p8: l10 {
+@@ -956,3 +1046,8 @@ hall_back_default: hall-back-default-state {
+ 		bias-disable;
+ 	};
+ };
++
++/* 3.10 vreg-1.8 is PM8994 L12. pciephy1 is 8994-only (cityman). */
++&pciephy0 {
++	vdda-supply = <&vreg_l12a_1p8>;
++};
+\ No newline at end of file
+diff --git a/arch/arm64/boot/dts/qcom/msm8994.dtsi b/arch/arm64/boot/dts/qcom/msm8994.dtsi
