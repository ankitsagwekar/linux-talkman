diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0014-pci-qcom-msm8994-keep-root-port-awake-during-reinit.patch b/device/testing/linux-postmarketos-qcom-msm8994/0014-pci-qcom-msm8994-keep-root-port-awake-during-reinit.patch
new file mode 100644
index 0000000000..bb06a03dd2
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0014-pci-qcom-msm8994-keep-root-port-awake-during-reinit.patch
@@ -0,0 +1,35 @@
+From: Claude <noreply@anthropic.com>
+Subject: [PATCH] PCI: qcom: msm8994: keep the root port awake while the RC is reinitialised
+
+The second bring-up pass tears the root complex down (clocks and PHY off)
+while the root port is still registered. If the PM core runtime-suspends the
+root port in that window, pci_pm_runtime_suspend() -> pci_save_state() reads
+its config space, which on an unclocked DWC core is a synchronous external
+abort: the kworker dies with irqs disabled and the phone freezes.
+
+Forbid runtime PM on the root port before the teardown.
+
+---
+ drivers/pci/controller/dwc/pcie-qcom.c | 12 ++++++++++++
+ 1 file changed, 12 insertions(+)
+
+--- a/drivers/pci/controller/dwc/pcie-qcom.c
++++ b/drivers/pci/controller/dwc/pcie-qcom.c
+@@ -1006,6 +1006,17 @@ static void qcom_pcie_host_post_msm8994(struct qcom_pcie *pcie)
+ 	if (!dw_pcie_link_up(pci)) {
+ 		dev_info(pci->dev, "first pass trained no link, redoing it powered\n");
+ 
++		{
++			/* runtime suspend would read config space with the RC off */
++			struct pci_dev *rp = pci_get_slot(pp->bridge->bus,
++							  PCI_DEVFN(0, 0));
++
++			if (rp) {
++				pm_runtime_forbid(&rp->dev);
++				pci_dev_put(rp);
++			}
++		}
++
+ 		QTRACE(pci->dev, "P1 host_deinit start");
+ 		qcom_pcie_host_deinit(pp);
+ 		QTRACE(pci->dev, "P2 host_deinit done");
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0015-pci-qcom-msm8994-wait-longer-for-the-slow-link.patch b/device/testing/linux-postmarketos-qcom-msm8994/0015-pci-qcom-msm8994-wait-longer-for-the-slow-link.patch
new file mode 100644
index 0000000000..5956d3fa1e
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0015-pci-qcom-msm8994-wait-longer-for-the-slow-link.patch
@@ -0,0 +1,30 @@
+From: Claude <noreply@anthropic.com>
+Subject: [PATCH] PCI: qcom: msm8994: wait up to 10 s for the QCA6174 link
+
+dw_pcie_wait_for_link() gives up after about 1 s, but the QCA6174 on this
+platform trains a bit later than that (a manual rescan seconds afterwards
+finds it). Keep polling before declaring the endpoint missing.
+
+---
+ drivers/pci/controller/dwc/pcie-qcom.c | 10 ++++++++++
+ 1 file changed, 10 insertions(+)
+
+--- a/drivers/pci/controller/dwc/pcie-qcom.c
++++ b/drivers/pci/controller/dwc/pcie-qcom.c
+@@ -1052,6 +1052,16 @@ static void qcom_pcie_host_post_msm8994(struct qcom_pcie *pcie)
+ 
+ 		QTRACE(pci->dev, "P9 wait_for_link");
+ 		ret = dw_pcie_wait_for_link(pci);
++		if (ret) {
++			/* the QCA6174 trains slowly: keep polling for up to 10 s */
++			int tries;
++
++			for (tries = 0; tries < 100 && !dw_pcie_link_up(pci); tries++)
++				msleep(100);
++			if (dw_pcie_link_up(pci))
++				ret = 0;
++			QTRACE(pci->dev, "P9b link %s after %d ms extra", ret ? "down" : "up", tries * 100);
++		}
+ 		QTRACE(pci->dev, "P10 wait_for_link done ret=%d", ret);
+ 		if (ret) {
+ 			dev_err(pci->dev, "endpoint did not answer (%d)\n", ret);
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0016-clk-qcom-add-MSM8994-and-MSM8992-CPU-cluster-clocks.patch b/device/testing/linux-postmarketos-qcom-msm8994/0016-clk-qcom-add-MSM8994-and-MSM8992-CPU-cluster-clocks.patch
