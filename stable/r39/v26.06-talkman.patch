++    items:
++      - const: c0-pll
++      - const: c1-pll
++      - const: c1-mux
++
++  '#clock-cells':
++    const: 1
++
++  clocks:
++    minItems: 2
++    items:
++      - description: XO source
++      - description: GPLL0 aux (safe parent)
++      - description: BIMC active set (3.10 bimc_a_clk). Optional.
++
++  clock-names:
++    minItems: 2
++    items:
++      - const: xo
++      - const: aux
