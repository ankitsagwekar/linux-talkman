+ 			regulator-system-load = <5800>;
++			/* USB HS PHY vdda33; downstream forces it on (vdda-force-on) */
++			regulator-always-on;
++			regulator-boot-on;
+ 		};
+ 
+ 		vreg_l25a_1p1: l25 {
