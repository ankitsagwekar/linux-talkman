diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0025-power-supply-qcom-pmi8994-fg-export-signed-battery-current.patch b/device/testing/linux-postmarketos-qcom-msm8994/0025-power-supply-qcom-pmi8994-fg-export-signed-battery-current.patch
new file mode 100644
index 0000000000..1a939fe76e
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0025-power-supply-qcom-pmi8994-fg-export-signed-battery-current.patch
@@ -0,0 +1,51 @@
+From c7cee04715fd2da9c0cbff06a00ddb9789df5c59 Mon Sep 17 00:00:00 2001
+From: Cursor Agent <cursoragent@cursor.com>
+Date: Tue, 6 Oct 2026 11:29:50 +0000
+Subject: [PATCH] power: supply: qcom-pmi8994-fg: export signed battery current
+
+current_now was the absolute value, so discharge and charge looked the
+same. The SRAM sample is a signed 16-bit QPNP FG_DATA_CURRENT value and
+PMI8994 sets PATCH_NEG_CURRENT_BIT. Export that sign. Negative is
+discharge, per sysfs-class-power.
+
+The 152.587 uA LSB is unchanged. It is the QPNP conversion for this
+register, and the termination-current encoder uses the same weight.
+
+Co-authored-by: EpicLPer <epiclper7@gmail.com>
+---
+ drivers/power/supply/qcom-pmi8994-fg.c | 15 ++++++++++++---
+ 1 file changed, 12 insertions(+), 3 deletions(-)
+
+diff --git a/drivers/power/supply/qcom-pmi8994-fg.c b/drivers/power/supply/qcom-pmi8994-fg.c
+index 4e2b6d2383aa5f..8da541a9f660e4 100644
+--- a/drivers/power/supply/qcom-pmi8994-fg.c
++++ b/drivers/power/supply/qcom-pmi8994-fg.c
+@@ -420,6 +420,12 @@ static int fg_voltage_uv(struct pmi8994_fg *fg, int *uv)
+ 	return 0;
+ }
+ 
++/*
++ * QPNP FG_DATA_CURRENT. The sample is the s16 at VOLTAGE_ADDR offset 3
++ * (0x5cc, 3). LSB_16B is 152.587 uA, the same weight as voltage, and the
++ * value is already signed. PMI8994 sets PATCH_NEG_CURRENT_BIT so discharge
++ * stays negative.
++ */
+ static int fg_current_ua(struct pmi8994_fg *fg, int *ua)
+ {
+ 	u16 raw;
+@@ -751,9 +757,12 @@ static int fg_get_property(struct power_supply *psy,
+ 		rc = fg_refresh_telem(fg);
+ 		if (rc)
+ 			return rc;
+-		/* Magnitude: UPower 1.91 treats current_now < 0 as discharge. */
+-		val->intval = fg->current_ua < 0 ? -fg->current_ua
+-						 : fg->current_ua;
++		/*
++		 * Signed uA, negative for discharge. The SRAM value is an
++		 * s16 and PMI8994 sets PATCH_NEG_CURRENT_BIT so that sign
++		 * is the one the block reports.
++		 */
++		val->intval = fg->current_ua;
+ 		return 0;
+ 	case POWER_SUPPLY_PROP_TEMP:
+ 		rc = fg_refresh_telem(fg);
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0026-power-supply-qcom-pmi8994-fg-report-charging-current-as-positive.patch b/device/testing/linux-postmarketos-qcom-msm8994/0026-power-supply-qcom-pmi8994-fg-report-charging-current-as-positive.patch
new file mode 100644
index 0000000000..c66ec146df
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0026-power-supply-qcom-pmi8994-fg-report-charging-current-as-positive.patch
@@ -0,0 +1,57 @@
+From 4dd2468bc2e165a19f0e974598c9cd8d7e2fc5d9 Mon Sep 17 00:00:00 2001
+From: Cursor Agent <cursoragent@cursor.com>
+Date: Tue, 6 Oct 2026 13:07:19 +0000
+Subject: [PATCH] power: supply: qcom-pmi8994-fg: report charging current as
+ positive
+
+FG_DATA_CURRENT and the termination-current encoder treat charge as
+negative. PATCH_NEG_CURRENT_BIT keeps that SRAM convention, so the
+raw sign made UPower treat charging as discharge.
+
+Negate once in fg_current_ua(). current_now is the only caller, so
+userspace sees charging as positive and discharging as negative.
+
+Co-authored-by: EpicLPer <epiclper7@gmail.com>
+---
+ drivers/power/supply/qcom-pmi8994-fg.c | 14 +++++++-------
+ 1 file changed, 7 insertions(+), 7 deletions(-)
+
+diff --git a/drivers/power/supply/qcom-pmi8994-fg.c b/drivers/power/supply/qcom-pmi8994-fg.c
+index 8da541a9f660e4..f5a14b05da9114 100644
+--- a/drivers/power/supply/qcom-pmi8994-fg.c
++++ b/drivers/power/supply/qcom-pmi8994-fg.c
+@@ -422,9 +422,10 @@ static int fg_voltage_uv(struct pmi8994_fg *fg, int *uv)
+ 
+ /*
+  * QPNP FG_DATA_CURRENT. The sample is the s16 at VOLTAGE_ADDR offset 3
+- * (0x5cc, 3). LSB_16B is 152.587 uA, the same weight as voltage, and the
+- * value is already signed. PMI8994 sets PATCH_NEG_CURRENT_BIT so discharge
+- * stays negative.
++ * (0x5cc, 3). LSB_16B is 152.587 uA, the same weight as voltage. The SRAM
++ * sample and the termination-current encoder treat charge as negative
++ * (PATCH_NEG_CURRENT_BIT keeps that convention), so negate for current_now.
++ * Userspace then sees charging as positive and discharging as negative.
+  */
+ static int fg_current_ua(struct pmi8994_fg *fg, int *ua)
+ {
+@@ -436,7 +437,7 @@ static int fg_current_ua(struct pmi8994_fg *fg, int *ua)
+ 	if (rc)
+ 		return rc;
+ 	sraw = (s16)raw;
+-	*ua = div_s64((s64)sraw * LSB_16B_NUM, LSB_16B_DEN);
++	*ua = -div_s64((s64)sraw * LSB_16B_NUM, LSB_16B_DEN);
+ 	return 0;
+ }
+ 
+@@ -758,9 +759,8 @@ static int fg_get_property(struct power_supply *psy,
+ 		if (rc)
+ 			return rc;
+ 		/*
+-		 * Signed uA, negative for discharge. The SRAM value is an
+-		 * s16 and PMI8994 sets PATCH_NEG_CURRENT_BIT so that sign
+-		 * is the one the block reports.
++		 * Signed microamps. fg_current_ua() already negated the
++		 * SRAM sample, so charging is positive here.
+ 		 */
+ 		val->intval = fg->current_ua;
+ 		return 0;
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0027-arm64-dts-qcom-lumia-talkman-PSCI-CPU-idle-states.patch b/device/testing/linux-postmarketos-qcom-msm8994/0027-arm64-dts-qcom-lumia-talkman-PSCI-CPU-idle-states.patch
new file mode 100644
index 0000000000..e4ee953b7c
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0027-arm64-dts-qcom-lumia-talkman-PSCI-CPU-idle-states.patch
@@ -0,0 +1,84 @@
+From: Claude <noreply@anthropic.com>
+Subject: [PATCH] arm64: dts: qcom: lumia-talkman: PSCI CPU idle states
+
+Idle states from EpicLPer 1ccb2e15 ("add MSM8994 PSCI idle and split CPU
+PMUs"), kept in the talkman board file: A53 retention + power collapse, A57
+retention only. Without them the phone draws ~760 mA idle, more than a PC
+USB port supplies.
+
+---
+--- a/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts	2026-11-14 23:55:29.197479133 +0530
++++ b/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts	2026-11-14 23:55:49.521341794 +0530
+@@ -231,3 +231,72 @@
+ 		F0 11 30 03 00 00 00 0C
+ 	];
+ };
++
++/*
++ * CPU idle states (EpicLPer 1ccb2e15, tested on the Lumia UEFI's PSCI): the
++ * A53s can retain and power-collapse; the A57s only retain, because this
++ * firmware does not wake them from a CPU_SUSPEND power-down.
++ */
++&{/cpus} {
++	idle-states {
++		entry-method = "psci";
++
++		little_cpu_sleep_0: cpu-sleep-0-0 {
++			compatible = "arm,idle-state";
++			idle-state-name = "little-retention";
++			arm,psci-suspend-param = <0x00000002>;
++			entry-latency-us = <50>;
++			exit-latency-us = <100>;
++			min-residency-us = <313>;
++			local-timer-stop;
++		};
++
++		little_cpu_sleep_1: cpu-sleep-0-1 {
++			compatible = "arm,idle-state";
++			idle-state-name = "little-spc";
++			arm,psci-suspend-param = <0x00010004>;
++			entry-latency-us = <400>;
++			exit-latency-us = <400>;
++			min-residency-us = <2000>;
++			local-timer-stop;
++		};
++
++		big_cpu_sleep_0: cpu-sleep-1-0 {
++			compatible = "arm,idle-state";
++			idle-state-name = "big-retention";
++			arm,psci-suspend-param = <0x00000002>;
++			entry-latency-us = <80>;
++			exit-latency-us = <120>;
++			min-residency-us = <400>;
++			local-timer-stop;
++		};
++	};
++};
++
++&{/psci} {
++	compatible = "arm,psci-1.0";
++};
++
++&cpu0 {
++	cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
++};
++
++&cpu1 {
++	cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
++};
++
++&cpu2 {
++	cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
++};
++
++&cpu3 {
++	cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
++};
++
++&cpu4 {
++	cpu-idle-states = <&big_cpu_sleep_0>;
++};
++
++&cpu5 {
++	cpu-idle-states = <&big_cpu_sleep_0>;
++};
