+From 53f9592c24c5dda8a51b584520a96b32220fc793 Mon Sep 17 00:00:00 2001
+From: Stefan <EpicLPer@users.noreply.github.com>
+Date: Fri, 11 Sep 2026 16:38:46 +0200
+Subject: [PATCH] clk: qcom: add MSM8994 and MSM8992 CPU cluster clocks
+
+v2 ping-pong PLLs, AO MX vote, and bimc_a 1555 MHz before A57 1824
+so the official speedbin0 tables can run without the ICC vote that
+resets this RPM.
+
+Co-authored-by: Cursor <cursoragent@cursor.com>
+---
+ .../bindings/clock/qcom,msm8994-cpu-clk.yaml  |  93 ++
+ drivers/clk/qcom/Kconfig                      |   8 +
+ drivers/clk/qcom/Makefile                     |   1 +
+ drivers/clk/qcom/clk-cpu-8994.c               | 939 ++++++++++++++++++
+ drivers/clk/qcom/clk-smd-rpm.c                |   1 +
+ include/dt-bindings/clock/qcom,msm8994-cpu.h  |   8 +
+ 6 files changed, 1050 insertions(+)
+ create mode 100644 Documentation/devicetree/bindings/clock/qcom,msm8994-cpu-clk.yaml
+ create mode 100644 drivers/clk/qcom/clk-cpu-8994.c
+ create mode 100644 include/dt-bindings/clock/qcom,msm8994-cpu.h
+
+diff --git a/Documentation/devicetree/bindings/clock/qcom,msm8994-cpu-clk.yaml b/Documentation/devicetree/bindings/clock/qcom,msm8994-cpu-clk.yaml
+new file mode 100644
+index 00000000000000..ebda2613ded582
+--- /dev/null
++++ b/Documentation/devicetree/bindings/clock/qcom,msm8994-cpu-clk.yaml
+@@ -0,0 +1,93 @@
++# SPDX-License-Identifier: GPL-2.0-only
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/clock/qcom,msm8994-cpu-clk.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: Qualcomm MSM8994 / MSM8992 CPU clock controller
++
++maintainers:
++  - Bjorn Andersson <andersson@kernel.org>
++
++description: |
++  CPU cluster clocks on MSM8994 and MSM8992. Clock 0 is the A53 cluster
++  and clock 1 is the A57 cluster.
++
++  The A53 mux lives in the APCS KPSS global region, which is already the
++  mailbox syscon at 0xf900d000. Do not map that window a second time.
++
++properties:
++  compatible:
++    oneOf:
++      - items:
++          - const: qcom,msm8992-cpu-clk
++          - const: qcom,msm8994-cpu-clk
++      - const: qcom,msm8994-cpu-clk
++
++  reg:
++    items:
++      - description: A53 PLL window (pll0 at +0x00, pll1/PLLA at +0x40)
++      - description: A57 PLL window (pll0 at +0x00, pll1/PLLA at +0x40)
