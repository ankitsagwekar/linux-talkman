diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0018-clk-qcom-clk-cpu-8994-add-recalc-rate-to-mux-ops.patch b/device/testing/linux-postmarketos-qcom-msm8994/0018-clk-qcom-clk-cpu-8994-add-recalc-rate-to-mux-ops.patch
new file mode 100644
index 0000000000..00351bd26c
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0018-clk-qcom-clk-cpu-8994-add-recalc-rate-to-mux-ops.patch
@@ -0,0 +1,25 @@
+From: Claude <noreply@anthropic.com>
+Subject: [PATCH] clk: qcom: clk-cpu-8994: add recalc_rate to the mux ops
+
+The 6.16 clk core rejects clocks that have .set_rate but no .recalc_rate
+("failed to register clk a53_lf_mux", -EINVAL). A mux runs at its parent rate.
+
+---
+--- a/drivers/clk/qcom/clk-cpu-8994.c
++++ b/drivers/clk/qcom/clk-cpu-8994.c
+@@ -585,7 +585,15 @@
+ 	return 0;
+ }
+ 
++/* 6.16's clk core insists on .recalc_rate next to .set_rate; a mux runs at its parent's rate */
++static unsigned long clk_cpu_8994_mux_recalc_rate(struct clk_hw *hw,
++						  unsigned long parent_rate)
++{
++	return parent_rate;
++}
++
+ static const struct clk_ops clk_cpu_8994_mux_ops = {
++	.recalc_rate = clk_cpu_8994_mux_recalc_rate,
+ 	.get_parent = clk_cpu_8994_mux_get_parent,
+ 	.set_parent = clk_cpu_8994_mux_set_parent,
+ 	.set_rate = clk_cpu_8994_mux_set_rate,
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0019-clk-qcom-clk-cpu-8994-safe-A57-mux-switch-Lumia-ACC-fallback.patch b/device/testing/linux-postmarketos-qcom-msm8994/0019-clk-qcom-clk-cpu-8994-safe-A57-mux-switch-Lumia-ACC-fallback.patch
new file mode 100644
index 0000000000..54bac6ad1f
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0019-clk-qcom-clk-cpu-8994-safe-A57-mux-switch-Lumia-ACC-fallback.patch
@@ -0,0 +1,181 @@
+From: Claude <noreply@anthropic.com>
+Subject: [PATCH] clk: qcom: clk-cpu-8994: Lumia stability fixes
+
+Switching an A57 cluster mux while an A57 core enters or leaves WFI hangs
+the cluster (the 3.10 driver works around it with its "low power mux
+switch" IPIs). Do the A57 mux writes under stop_machine().
+
+The boot firmware can leave an idle PLL with its enable bits set but no
+usable output (Lumia 950 A57 PLL1): switching onto it hangs the cluster.
+Switch idle PLLs off at probe so the first use always relocks them.
+
+Back-to-back PLL relocks and mux switches hang the phone within the first
+cpufreq transitions; give each one 10 ms to settle (module parameter
+settle_us).
+
+The A57 ACC registers are secure-only and the Lumia secure firmware rejects
+qcom_scm_io_writel() with -EOPNOTSUPP (a direct write hangs). Warn once and
+carry on; without the ACC the A57 is only stable up to 768 MHz.
+
+---
+--- a/drivers/clk/qcom/clk-cpu-8994.c
++++ b/drivers/clk/qcom/clk-cpu-8994.c
+@@ -14,6 +14,7 @@
+ #include <linux/clk-provider.h>
+ #include <linux/delay.h>
+ #include <linux/firmware/qcom/qcom_scm.h>
++#include <linux/stop_machine.h>
+ #include <linux/io.h>
+ #include <linux/mfd/syscon.h>
+ #include <linux/module.h>
+@@ -78,9 +79,44 @@
+ #define ACC_A57_TYPE4		0x0b
+ 
+ static DEFINE_SPINLOCK(cpu_8994_mux_lock);
++
++/* Set once the secure world refuses the A57 ACC writes (Lumia firmware). */
++static bool a57_acc_unsupported;
++
++/*
++ * Settle time after every PLL relock and cluster mux switch. Back-to-back
++ * switching without it hangs the phone within the first cpufreq transitions
++ * (the 3.10 driver gets this spacing implicitly); 10 ms is tested stable.
++ */
++static unsigned int settle_us = 10000;
++module_param(settle_us, uint, 0644);
++
++static void clk_cpu_8994_settle(void)
++{
++	if (settle_us)
++		usleep_range(settle_us, settle_us + settle_us / 2);
++}
++
++struct cpu_8994_mux_write {
++	struct regmap *map;
++	unsigned int reg, mask, val;
++	int ret;
++};
++
++static int clk_cpu_8994_mux_write_fn(void *data)
++{
++	struct cpu_8994_mux_write *w = data;
++
++	w->ret = regmap_update_bits(w->map, w->reg, w->mask, w->val);
++	/* Ensure the switch went through; hardware mandated delay */
++	mb();
++	udelay(5);
++	return 0;
++}
+ static phys_addr_t a57_mux_phys;
+ static struct clk_regmap_mux a53_hf_mux;
+ static struct clk_regmap_mux a57_hf_mux;
++static struct clk_regmap_mux a57_lf_mux;
+ static struct device *cpu_8994_dev;
+ static struct clk *cpu_8994_bimc;
+ static unsigned long a53_cpu_rate;
+@@ -373,6 +409,7 @@
+ 			clk_cpu_8994_pll_enable(pll);
+ 	}
+ 	spin_unlock_irqrestore(&pll->lock, flags);
++	clk_cpu_8994_settle();
+ 
+ 	return ret;
+ }
+@@ -446,7 +483,22 @@
+ 	u32 t1_3 = pll_early ? ACC_A57_HIGH : ACC_A57_LOW;
+ 	int ret;
+ 
++	if (a57_acc_unsupported)
++		return 0;
++
+ 	ret = qcom_scm_io_writel(a57_mux_phys + ACC_TYPE1, t1_3);
++	if (ret == -EOPNOTSUPP) {
++		/*
++		 * The ACC registers are secure-only and the Lumia (Microsoft)
++		 * secure firmware has no io-write call. The A57 then runs with
++		 * the firmware's ACC setting, which is only stable up to
++		 * 768 MHz (960 MHz hangs under sustained load), so the OPP
++		 * table must stop there.
++		 */
++		pr_warn_once("clk-cpu-8994: secure world cannot program the A57 ACC; keep the A57 at or below 768 MHz\n");
++		a57_acc_unsupported = true;
++		return 0;
++	}
+ 	if (ret)
+ 		return ret;
+ 	ret = qcom_scm_io_writel(a57_mux_phys + ACC_TYPE2, t1_3);
+@@ -504,10 +556,28 @@
+ 			return ret;
+ 	}
+ 
+-	spin_lock_irqsave(&cpu_8994_mux_lock, flags);
+-	ret = regmap_update_bits(clkr->regmap, mux->reg, mask,
+-				 index << mux->shift);
+-	spin_unlock_irqrestore(&cpu_8994_mux_lock, flags);
++	clk_cpu_8994_settle();
++	if (hw == &a57_hf_mux.clkr.hw || hw == &a57_lf_mux.clkr.hw) {
++		/*
++		 * 3.10 "low power mux switch": an A57 cluster mux may only be
++		 * switched while no A57 core enters or leaves WFI, or the
++		 * cluster hangs. Write it under stop_machine(), with every other
++		 * CPU spinning with IRQs off.
++		 */
++		struct cpu_8994_mux_write w = {
++			.map = clkr->regmap, .reg = mux->reg, .mask = mask,
++			.val = index << mux->shift,
++		};
++
++		stop_machine(clk_cpu_8994_mux_write_fn, &w, NULL);
++		ret = w.ret;
++	} else {
++		spin_lock_irqsave(&cpu_8994_mux_lock, flags);
++		ret = regmap_update_bits(clkr->regmap, mux->reg, mask,
++					 index << mux->shift);
++		spin_unlock_irqrestore(&cpu_8994_mux_lock, flags);
++	}
++	clk_cpu_8994_settle();
+ 	if (ret)
+ 		return ret;
+ 
+@@ -704,6 +774,26 @@
+ 	},
+ };
+ 
++/*
++ * The boot firmware can leave a PLL that no cluster runs from with its
++ * enable bits set but not producing a usable clock (seen on the Lumia 950 A57
++ * PLL1: switching the LF mux onto it hangs the cluster). Switch such idle
++ * PLLs off at probe, so the first switch onto one always relocks it.
++ */
++static void clk_cpu_8994_park_idle_plls(u32 mux, struct clk_cpu_8994_pll *pll0,
++					struct clk_cpu_8994_pll *pll1)
++{
++	u32 hf = (mux >> HF_MUX_SHIFT) & GENMASK(MUX_WIDTH - 1, 0);
++	u32 lf = (mux >> LF_MUX_SHIFT) & GENMASK(MUX_WIDTH - 1, 0);
++	bool use0 = hf == 3 || (hf == 0 && lf == 2);
++	bool use1 = hf == 1 || (hf == 0 && lf == 1);
++
++	if (!use0)
++		clk_cpu_8994_pll_disable(pll0);
++	if (!use1)
++		clk_cpu_8994_pll_disable(pll1);
++}
++
+ static void clk_cpu_8994_pll1_init_hw(struct clk_cpu_8994_pll *pll)
+ {
+ 	if (clk_cpu_8994_pll_enabled(pll))
+@@ -883,6 +973,14 @@
+ 	if (ret)
+ 		return ret;
+ 
++	{
++		unsigned int a53_mux = 0;
++
++		regmap_read(apcs, MUX_OFFSET, &a53_mux);
++		clk_cpu_8994_park_idle_plls(a53_mux, &a53_pll0, &a53_pll1);
++		clk_cpu_8994_park_idle_plls(readl_relaxed(c1_mux + MUX_OFFSET),
++					    &a57_pll0, &a57_pll1);
++	}
+ 	clk_cpu_8994_pll1_init_hw(&a53_pll1);
+ 	clk_cpu_8994_pll1_init_hw(&a57_pll1);
+ 
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0020-arm64-dts-qcom-lumia-octagon-keep-VDD_GFX-on.patch b/device/testing/linux-postmarketos-qcom-msm8994/0020-arm64-dts-qcom-lumia-octagon-keep-VDD_GFX-on.patch
new file mode 100644
index 0000000000..7d0004ca74
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0020-arm64-dts-qcom-lumia-octagon-keep-VDD_GFX-on.patch
@@ -0,0 +1,29 @@
+From: Claude <noreply@anthropic.com>
+Subject: [PATCH] arm64: dts: qcom: lumia-octagon: keep VDD_GFX on
+
+PMI8994 S2 (VDD_GFX) is also managed by the RPM. With no GPU consumer the
+regulator core disables it 30 s after boot, which leaves the RPM unresponsive
+(every RPM request times out) and the phone resets minutes later.
+
+---
+--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi	2026-11-14 17:51:13.838844140 +0530
++++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi	2026-11-14 17:51:16.200798186 +0530
+@@ -536,9 +536,18 @@
+ };
+ 
+ &pmi8994_spmi_regulators {
++	/*
++	 * PMI8994 S2 is VDD_GFX, which the RPM also owns (rpmpd gfx_s2b).
++	 * Nothing consumes it until the GPU is supported, so the regulator
++	 * core's "disable unused" pass would switch it off ~30 s after boot,
++	 * behind the RPM's back: the RPM then stops answering every request
++	 * (all RPM-managed clocks, rails and power domains) and the phone
++	 * later resets. Keep it on.
++	 */
+ 	vdd_gfx: s2 {
+ 		regulator-min-microvolt = <980000>;
+ 		regulator-max-microvolt = <980000>;
++		regulator-always-on;
+ 	};
+ };
+ 
diff --git a/device/testing/linux-postmarketos-qcom-msm8994/0021-power-supply-qcom-add-PMI8994-QPNP-fuel-gauge.patch b/device/testing/linux-postmarketos-qcom-msm8994/0021-power-supply-qcom-add-PMI8994-QPNP-fuel-gauge.patch
new file mode 100644
index 0000000000..eef18edaba
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8994/0021-power-supply-qcom-add-PMI8994-QPNP-fuel-gauge.patch
@@ -0,0 +1,1023 @@
+From d81ae8d73b3d8995612ec84bf8378bcfba8748a0 Mon Sep 17 00:00:00 2001
+From: Stefan <EpicLPer@users.noreply.github.com>
+Date: Wed, 9 Sep 2026 19:00:12 +0200
+Subject: [PATCH] power: supply: qcom: add PMI8994 QPNP fuel gauge
+
+Report SoC, voltage, current, and battery temperature from FG SRAM
+through MEMIF. Load a 128-byte profile only when the ID resistor
+matches; otherwise leave SRAM alone and still report hardware SoC.
+
+Co-authored-by: Cursor <cursoragent@cursor.com>
+---
+ .../power/supply/qcom,pmi8994-fg.yaml         |  96 ++
+ arch/arm64/configs/mmo_defconfig              |   1 +
+ drivers/power/supply/Kconfig                  |  11 +
+ drivers/power/supply/Makefile                 |   1 +
+ drivers/power/supply/qcom-pmi8994-fg.c        | 861 ++++++++++++++++++
+ 5 files changed, 970 insertions(+)
+ create mode 100644 Documentation/devicetree/bindings/power/supply/qcom,pmi8994-fg.yaml
+ create mode 100644 drivers/power/supply/qcom-pmi8994-fg.c
+
+diff --git a/Documentation/devicetree/bindings/power/supply/qcom,pmi8994-fg.yaml b/Documentation/devicetree/bindings/power/supply/qcom,pmi8994-fg.yaml
+new file mode 100644
+index 00000000000000..48ff8ac99609e9
+--- /dev/null
++++ b/Documentation/devicetree/bindings/power/supply/qcom,pmi8994-fg.yaml
+@@ -0,0 +1,96 @@
++# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/power/supply/qcom,pmi8994-fg.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: Qualcomm PMI8994 QPNP fuel gauge
++
++maintainers:
++  - Konrad Dybcio <konradybcio@kernel.org>
++
++description: |
++  QPNP fuel gauge in PMI8994. State of charge, voltage, current, and
++  battery temperature live in FG SRAM, accessed through the MEMIF
++  peripheral at 0x4400. The gauge identifies the pack by measuring
++  the battery ID resistor.
++
++  A 128-byte profile is loaded only when the measured ID is within
++  qcom,batt-id-range-pct of qcom,batt-id-kohm. Otherwise the hardware
++  SoC is reported and SRAM is left unchanged.
++
++allOf:
++  - $ref: power-supply.yaml#
++
++properties:
++  compatible:
++    const: qcom,pmi8994-fg
++
++  reg:
++    maxItems: 1
++    description: FG_SOC peripheral base (0x4000 on PMI8994)
++
++  qcom,batt-id-kohm:
++    $ref: /schemas/types.yaml#/definitions/uint32
++    description: Expected battery ID resistor in kΩ
++
++  qcom,batt-id-range-pct:
++    $ref: /schemas/types.yaml#/definitions/uint32
++    description: |
++      Allowed deviation of the measured ID from qcom,batt-id-kohm,
++      as a percentage of that value.
++
++  qcom,fg-profile-data:
++    $ref: /schemas/types.yaml#/definitions/uint8-array
++    minItems: 128
++    maxItems: 128
++    description: 128-byte FG SRAM profile from the PMI8994 GUI tool
++
++  qcom,battery-type:
++    $ref: /schemas/types.yaml#/definitions/string
++
++  qcom,thermal-coefficients:
++    $ref: /schemas/types.yaml#/definitions/uint8-array
++    minItems: 6
++    maxItems: 6
++    description: Six-byte thermistor coefficients written to SRAM 0x444
++
++  qcom,cool-bat-decidegc:
++    $ref: /schemas/types.yaml#/definitions/int32
++  qcom,warm-bat-decidegc:
++    $ref: /schemas/types.yaml#/definitions/int32
++  qcom,cold-bat-decidegc:
++    $ref: /schemas/types.yaml#/definitions/int32
++  qcom,hot-bat-decidegc:
++    $ref: /schemas/types.yaml#/definitions/int32
++
++  qcom,fg-cutoff-voltage-mv:
++    $ref: /schemas/types.yaml#/definitions/uint32
++  qcom,fg-iterm-ma:
++    $ref: /schemas/types.yaml#/definitions/uint32
++  qcom,fg-chg-iterm-ma:
++    $ref: /schemas/types.yaml#/definitions/uint32
++  qcom,resume-soc:
++    $ref: /schemas/types.yaml#/definitions/uint32
++
++  monitored-battery: true
++
++required:
++  - compatible
++  - reg
++
++unevaluatedProperties: false
++
++examples:
++  - |
++    pmic {
++      #address-cells = <1>;
++      #size-cells = <0>;
++
++      fuel-gauge@4000 {
++        compatible = "qcom,pmi8994-fg";
++        reg = <0x4000>;
++        qcom,batt-id-kohm = <330>;
++        qcom,batt-id-range-pct = <15>;
++      };
++    };
+diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
+index b89ef40df7f82a..796a7f30fc3087 100644
+--- a/drivers/power/supply/Kconfig
++++ b/drivers/power/supply/Kconfig
+@@ -756,6 +756,17 @@ config BATTERY_PM8916_BMS_VM
+ 	  To compile this driver as module, choose M here: the
+ 	  module will be called pm8916_bms_vm.
+ 
++config BATTERY_QCOM_PMI8994_FG
++	tristate "Qualcomm PMI8994 QPNP fuel gauge"
++	depends on MFD_SPMI_PMIC || COMPILE_TEST
++	help
++	  Say Y to add support for the QPNP fuel gauge in PMI8994.
++	  The gauge reports SoC, voltage, current, temperature, and
++	  the battery-ID resistor through the MEMIF SRAM window.
++
++	  To compile this driver as module, choose M here: the
++	  module will be called qcom-pmi8994-fg.
++
+ config CHARGER_PM8916_LBC
+ 	tristate "Qualcomm PM8916 Linear Battery Charger support"
+ 	depends on MFD_SPMI_PMIC || COMPILE_TEST
+diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
+index f3c0d1006c1a2a..3c1f991522ab42 100644
+--- a/drivers/power/supply/Makefile
++++ b/drivers/power/supply/Makefile
+@@ -96,6 +96,7 @@ obj-$(CONFIG_CHARGER_MT6360)	+= mt6360_charger.o
+ obj-$(CONFIG_CHARGER_MT6370)	+= mt6370-charger.o
+ obj-$(CONFIG_CHARGER_QCOM_SMBB)	+= qcom_smbb.o
+ obj-$(CONFIG_BATTERY_PM8916_BMS_VM)	+= pm8916_bms_vm.o
++obj-$(CONFIG_BATTERY_QCOM_PMI8994_FG)	+= qcom-pmi8994-fg.o
+ obj-$(CONFIG_CHARGER_PM8916_LBC)	+= pm8916_lbc.o
+ obj-$(CONFIG_CHARGER_BQ2415X)	+= bq2415x_charger.o
+ obj-$(CONFIG_CHARGER_BQ24190)	+= bq24190_charger.o
+diff --git a/drivers/power/supply/qcom-pmi8994-fg.c b/drivers/power/supply/qcom-pmi8994-fg.c
+new file mode 100644
+index 00000000000000..6b1a50afe0c343
+--- /dev/null
++++ b/drivers/power/supply/qcom-pmi8994-fg.c
+@@ -0,0 +1,861 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Qualcomm PMI8994 QPNP fuel gauge.
++ *
++ * SRAM is reached through the MEMIF peripheral (0x4400). Register map
++ * and LSB weights match the QPNP FG block in PMI8994 / PMI8950.
++ */
++
++#include <linux/bitops.h>
++#include <linux/cleanup.h>
++#include <linux/delay.h>
++#include <linux/kernel.h>
++#include <linux/module.h>
++#include <linux/mutex.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/power_supply.h>
++#include <linux/property.h>
++#include <linux/regmap.h>
++#include <linux/slab.h>
++#include <linux/types.h>
++
++#define FG_SOC_BASE			0x4000
++#define FG_BATT_BASE			0x4100
++#define FG_MEMIF_BASE			0x4400
++
++#define REG_PERPH_TYPE			0x04
++#define REG_PERPH_SUBTYPE		0x05
++#define REG_INT_RT_STS			0x10
++
++#define FG_SUBTYPE_SOC			0x09
++#define FG_SUBTYPE_BATT			0x0a
++#define FG_SUBTYPE_MEMIF		0x0c
++
++#define SOC_MONOTONIC_SOC		0x09
++#define SOC_BOOT_MOD			0x50
++#define SOC_RESTART			0x51
++#define NO_OTP_PROF_RELOAD		BIT(6)
++#define REDO_FIRST_ESTIMATE		BIT(3)
++#define RESTART_GO			BIT(0)
++#define FIRST_EST_DONE_BIT		BIT(5)
++
++#define MEM_INTF_CFG			0x40
++#define MEM_INTF_CTL			0x41
++#define MEM_INTF_ADDR_LSB		0x42
++#define MEM_INTF_WR_DATA0		0x48
++#define MEM_INTF_RD_DATA0		0x4c
++#define RIF_MEM_ACCESS_REQ		BIT(7)
++#define INTF_CTL_BURST			BIT(7)
++#define INTF_CTL_WR_EN			BIT(6)
++#define MEM_AVAIL_BIT			BIT(0)
++
++#define RAM_OFFSET			0x400
++#define BATT_TEMP_ADDR			0x550
++#define BATT_TEMP_OFF			2
++#define VOLTAGE_ADDR			0x5cc
++#define VOLTAGE_OFF			1
++#define CURRENT_OFF			3
++#define BATT_ID_ADDR			0x594
++#define BATT_ID_OFF			1
++#define BATT_ID_INFO_OFF		3
++#define BATT_PROFILE_OFFSET		0x4c0
++#define PROFILE_INTEGRITY_REG		0x53c
++#define PROFILE_INTEGRITY_BIT		BIT(0)
++#define THERMAL_COEFF_ADDR		0x444
++#define THERMAL_COEFF_OFF		2
++#define THERMAL_COEFF_N_BYTES		6
++#define JEITA_ADDR			0x454
++#define CUTOFF_VOLTAGE_ADDR		0x40c
++#define TERM_CURRENT_ADDR		0x40c
++#define TERM_CURRENT_OFF		2
++#define CHG_TERM_ADDR			0x4f8
++#define CHG_TERM_OFF			2
++#define RESUME_SOC_ADDR			0x45c
++#define RESUME_SOC_OFF			1
++#define EXTERNAL_SENSE_SELECT		0x4ac
++#define EXTERNAL_SENSE_OFF		2
++#define BATT_TEMP_CNTRL_OFF		3
++#define BATT_TEMP_CNTRL_MASK		0x17
++#define TEMP_SENSE_ALWAYS_BIT		BIT(1)
++#define PATCH_NEG_CURRENT_BIT		BIT(3)
++#define BATT_IDED			BIT(3)
++#define FG_PROFILE_LEN			128
++#define PROFILE_COMPARE_LEN		32
++
++#define LSB_16B_NUM			152587
++#define LSB_16B_DEN			1000
++#define LSB_8B				9800
++#define TEMP_LSB_16B			625
++#define DECIKELVIN			2730
++
++#define FULL_SOC_RAW			0xff
++#define MEMIF_TIMEOUT_MS		5000
++#define FIRST_EST_TIMEOUT_MS		5000
++#define MAX_SOC_TRIES			5
++
++static const u8 bias_ua[] = {
++	[1] = 5,
++	[2] = 15,
++	[3] = 150,
++};
