++	if (!(uc->reg5 & UC120_REG5_VBUS))
++		return;
++	/* Brief PRESENT=0 (APSD) must not drop FPGA Rd. */
++	delay = (uc->last_state == UC120_STATE_UFP ||
++		 uc->last_state == UC120_STATE_PWR_ACC ||
++		 uc->typec_icl_ua) ? 500 : UC120_CC_DEBOUNCE_MS;
