++struct pmi8994_fg {
++	struct device *dev;
++	struct regmap *regmap;
++	struct power_supply *psy;
++	struct mutex lock;
++	u32 soc_base;
++	u32 batt_base;
++	u32 mem_base;
++	bool unknown_battery;
++	int id_kohm;
++	int max_voltage_uv;
++	int nom_cap_uah;
++	const char *batt_type;
++	u8 thermal_coeff[THERMAL_COEFF_N_BYTES];
++	bool has_thermal_coeff;
++	s32 jeita_decidegc[4];
