From: Stefan (EpicLPer) / Ankit <ankits@outlook.sg>
Subject: [PATCH] lumia-octagon: MSM8994/8992 PCIe RC + QCA6174A Wi-Fi

Backport of EpicLPer/linux commits 7bedb9e313 and 003190c3e3 (PCIe DWC
support for qcom,pcie-msm8994, 20nm QMP PCIe PHY driver, gcc pipe/aux
parents, ECRC opt-out, QCA6174A power and pin setup) to 6.16, verified
upstream on a Lumia 950 XL.

Talkman (MSM8992) additions:
- enable RC0 (pcie0) with the 8992 pins TLMM 35/36/37 (pcie1_default
  group), as in downstream msm8992-pinctrl.dtsi;
- toggle the right block reset per RC (GCC_PCIE_0_BCR 0x1ac0 for RC0,
  GCC_PCIE_1_BCR 0x1b40 for RC1) instead of always PCIe1;
- pwrseq-qcom-wcn changes dropped (no consumer, needs newer pwrseq API).
---
diff --git a/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts b/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts
index db3c4d4b1..a6370aa3b 100644
--- a/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts
+++ b/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts
@@ -35,3 +35,26 @@ &pmi8994_smbchg {
 &uc120 {
 	vbus-supply = <&pmi8994_otg>;
 };
+
+/*
+ * QCA6174A Wi-Fi on PCIe RC0. On MSM8992 RC0 uses TLMM 35/36/37 (PERST#,
+ * CLKREQ# as pci_e1 mux, WAKE#), i.e. the pins named pcie1_default here
+ * (downstream msm8992-pinctrl.dtsi pcie0_*). Supplies as on Cityman RC1.
+ */
+&pciephy0 {
+	status = "okay";
+};
+
+&pcie0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie1_default &wlan_bootstrap_default>;
+	vdda-supply = <&vreg_l28a_1p0>;
+	vddpe-3v3-supply = <&wlan_en>;
+	qcom,no-ecrc;
+	wake-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
+
+	pcie@0 {
+		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/msm8992.dtsi b/arch/arm64/boot/dts/qcom/msm8992.dtsi
index b2dc46c25..b744732f7 100644
--- a/arch/arm64/boot/dts/qcom/msm8992.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8992.dtsi
@@ -13,8 +13,14 @@
 
 &gcc {
 	compatible = "qcom,gcc-msm8992";
+	clock-names = "xo", "sleep", "pcie_0_pipe";
+	clocks = <&xo_board>, <&sleep_clk>, <&pciephy0>;
 };
 
+/* 8992 has no PCIe1. Cityman WiFi is 8994 pcie1. */
+/delete-node/ &pcie1;
+/delete-node/ &pciephy1;
+
 &mmcc {
 	compatible = "qcom,mmcc-msm8992";
 
diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts
index c59341820..10e4d27a2 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman.dts
@@ -14,3 +14,52 @@ / {
 	compatible = "microsoft,cityman", "qcom,msm8994";
 	chassis-type = "handset";
 };
+
+&pciephy1 {
+	status = "okay";
+	vdda-supply = <&vreg_l12a_1p8>;
+};
+
+&pcie1 {
+	status = "okay";
+	pinctrl-names = "default";
+	/*
+	 * `pcie1_default` also carries the CNSS bootstrap pin (TLMM 112): it is
+	 * applied before ops->init() raises WLAN_EN, so the endpoint sees the
+	 * vendor's order (bootstrap high -> >=10 ms -> WLAN_EN -> RC bring-up).
+	 */
+	pinctrl-0 = <&pcie1_default &wlan_bootstrap_default>;
+	vdda-supply = <&vreg_l28a_1p0>;
+	vddpe-3v3-supply = <&wlan_en>;
+
+	/*
+	 * Do not let the DWC ATU force a TLP Digest (ECRC) onto outgoing TLPs.
+	 * On cores older than 5.10A the ATU 'TD' bit overrides the ECRC setting,
+	 * so mainline appends a TLP Digest to every TLP the ATU translates. The
+	 * vendor 3.10 stack never programs it: its live dump reads
+	 * iATU CTRL1 = 0x00000004 (transaction type only) where mainline reads
+	 * 0x00000104, and on an EP that enumerates the difference is real. 3.10
+	 * has no ECRC/TD handling in its DWC at all.
+	 */
+	qcom,no-ecrc;
+
+	/*
+	 * 3.10 pci-msm has `wake-gpio = <&msm_gpio 37 0>` on this node and
+	 * requests it as a falling-edge IRQ ("msm_pcie_wake"). The Lumia DT
+	 * deletes `qcom,ep-wakeirq` (msm8994-chi.dtsi), so enumeration is not
+	 * gated on it there - but the line is wired and worth watching:
+	 * asserted (low) means the endpoint wants the host's attention.
+	 */
+	wake-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
+
+	/*
+	 * PERST# is an endpoint property and belongs on the port node:
+	 * with `perst-gpios` on the Root Complex, qcom_pcie_parse_perst()
+	 * falls back to it and warns "DT needs to be fixed!" instead of
+	 * driving the port's own reset-gpios.
+	 */
+	pcie@0 {
+		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+	};
+};
+
diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
index e3475b69f..a5ca16aa8 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
@@ -59,6 +59,59 @@ divclk4: divclk4 {
 		};
 	};
 
+	/*
+	 * QCA6174 as a power-sequencing provider (models the WLAN PMU via
+	 * pwrseq-qcom-wcn). The discrete
+	 * Rome chip is powered by the PCIe PHY rail (vdda), the module enable
+	 * line (vddpe-3v3 = wlan_en), and clocked by the 32.768 kHz sleep clock
+	 * (divclk4). The provider enables them in order before the RC is trained.
+	 */
+	wcn_pmu: power-sequencer {
+		compatible = "qcom,qca6174-pmu";
+		vdda-supply = <&vreg_l28a_1p0>;
+		vddpe-3v3-supply = <&wlan_en>;
+		clocks = <&divclk4>;
+		#power-domain-cells = <0>;
+	};
+
+	/*
+	 * 3.10 bt_vreg / wlan_vreg share PM8994 GPIO 9
+	 * (WLAN_LDO_3V_CTRL). QCA6174 chip enable is TLMM 113.
+	 */
+	wlan_vreg: wlan-vreg {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vreg";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pm8994_gpios 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <4000>;
+		/*
+		 * This pin is the enable of the module's 3.3 V LDO (vendor name
+		 * `bt-vdd-pa`/`vdd-wlan`). The vendor DT configures PM8994 GPIO 9
+		 * with `vin-sel = PM8994_GPIO_VPH` (it is the only output in that
+		 * node not using vin-sel=<2>); without an explicit pin state
+		 * mainline keeps the firmware's VIN2 (1.8 V) source, which can
+		 * leave the LDO's EN threshold unmet.
+		 */
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_vreg_default &wlan_clk_default>;
+	};
+
+	wlan_en: wlan-en {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 113 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&wlan_vreg>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en_default>;
+		/* match the working msm8996-xiaomi-common QCA6174a wlan_en delay */
+		startup-delay-us = <70000>;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 		autorepeat;
@@ -497,6 +550,33 @@ qca6174_bt: bluetooth {
 };
 
 &pm8994_gpios {
+	wlan_vreg_default: wlan-vreg-state {
+		pinconf {
+			pins = "gpio9";
+			function = PMIC_GPIO_FUNC_NORMAL;
+			power-source = <PM8994_GPIO_VPH>;
+			bias-disable;
+		};
+	};
+
+	/*
+	 * PM8994 GPIO 18 = DIVCLK4 = the 32.768 kHz sleep clock fed to the
+	 * QCA6174. The `divclk4` fixed-clock node declares pinctrl-0 =
+	 * <&divclk4_pin_a>, but `fixed-clock` is registered by
+	 * CLK_OF_DECLARE and clk-fixed-rate.c contains no pinctrl handling at
+	 * all, so that state is never applied and the pin keeps whatever
+	 * firmware left. This group is attached to wlan-vreg (a real platform
+	 * device) so that it actually gets programmed.
+	 */
+	wlan_clk_default: wlan-clk-state {
+		pinconf {
+			pins = "gpio18";
+			function = PMIC_GPIO_FUNC_FUNC2;
+			power-source = <PM8994_GPIO_S4>;
+			bias-disable;
+		};
+	};
+
 	bt_en_gpios: bt-en-gpios-state {
 		pinconf {
 			pins = "gpio19";
@@ -509,10 +589,17 @@ pinconf {
 	};
 
 	divclk4_pin_a: divclk4-state {
+		/*
+		 * Vendor GPIO18 (DIVCLK4) config: FUNC2, VIN2, medium drive,
+		 * output enabled, so the PMIC divider really outputs the
+		 * 32.768 kHz sleep clock the QCA6174 (Wi-Fi and BT) need.
+		 */
 		pinconf {
 			pins = "gpio18";
 			function = PMIC_GPIO_FUNC_FUNC2;
 			power-source = <PM8994_GPIO_S4>;
+			qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+			output-low;
 			bias-disable;
 		};
 	};
@@ -604,6 +691,8 @@ vreg_s3a_1p3: s3 {
 			regulator-max-microvolt = <1300000>;
 			regulator-allow-set-load;
 			regulator-system-load = <300000>;
+			/* required by QCA6174a vdd-core */
+			regulator-always-on;
 		};
 
 		vreg_s4a_1p8: s4 {
@@ -678,6 +767,7 @@ vreg_l8a_1p8: l8 {
 		vreg_l9a_1p8: l9 {
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
+
 		};
 
 		vreg_l10a_1p8: l10 {
@@ -956,3 +1046,8 @@ hall_back_default: hall-back-default-state {
 		bias-disable;
 	};
 };
+
+/* 3.10 vreg-1.8 is PM8994 L12. pciephy1 is 8994-only (cityman). */
+&pciephy0 {
+	vdda-supply = <&vreg_l12a_1p8>;
+};
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/qcom/msm8994.dtsi b/arch/arm64/boot/dts/qcom/msm8994.dtsi
index b509c0103..31c03ba25 100644
--- a/arch/arm64/boot/dts/qcom/msm8994.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8994.dtsi
@@ -674,8 +674,11 @@ blsp2_uart2: serial@f995e000 {
 			clock-names = "core", "iface";
 			clocks = <&gcc GCC_BLSP2_UART2_APPS_CLK>,
 					<&gcc GCC_BLSP2_AHB_CLK>;
-			dmas = <&blsp2_dma 2>, <&blsp2_dma 3>;
-			dma-names = "tx", "rx";
+			/*
+			 * The QCA6174 is held in reset while the BLSP2 DMA
+			 * channels are attached to this UART, so the dmas
+			 * properties are intentionally omitted.
+			 */
 			pinctrl-names = "default", "sleep";
 			pinctrl-0 = <&blsp2_uart2_default>;
 			pinctrl-1 = <&blsp2_uart2_sleep>;
@@ -742,8 +745,179 @@ gcc: clock-controller@fc400000 {
 			#power-domain-cells = <1>;
 			reg = <0xfc400000 0x2000>;
 
-			clock-names = "xo", "sleep";
-			clocks = <&xo_board>, <&sleep_clk>;
+			clock-names = "xo", "sleep", "pcie_0_pipe", "pcie_1_pipe";
+			clocks = <&xo_board>, <&sleep_clk>, <&pciephy0>, <&pciephy1>;
+		};
+
+		pciephy0: phy@fc526000 {
+			compatible = "qcom,msm8994-qmp-pcie-phy";
+			reg = <0xfc526000 0x1000>;
+			clocks = <&rpmcc RPM_SMD_LN_BB_CLK>,
+				 <&gcc PCIE_0_PHY_LDO>,
+				 <&gcc GCC_PCIE_0_PIPE_CLK>;
+			clock-names = "ref", "ldo", "pipe";
+			resets = <&gcc PCIE_PHY_0_RESET>;
+			reset-names = "phy";
+			#clock-cells = <0>;
+			clock-output-names = "pcie_0_pipe";
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
+		pciephy1: phy@fc52e000 {
+			compatible = "qcom,msm8994-qmp-pcie-phy";
+			reg = <0xfc52e000 0x1000>;
+			clocks = <&rpmcc RPM_SMD_LN_BB_CLK>,
+				 <&gcc PCIE_1_PHY_LDO>,
+				 <&gcc GCC_PCIE_1_PIPE_CLK>;
+			clock-names = "ref", "ldo", "pipe";
+			resets = <&gcc PCIE_PHY_1_RESET>;
+			reset-names = "phy";
+			#clock-cells = <0>;
+			clock-output-names = "pcie_1_pipe";
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
+		pcie0: pcie@fc520000 {
+			compatible = "qcom,pcie-msm8994";
+			status = "disabled";
+			reg = <0xfc520000 0x2000>,
+			      <0xff000000 0xf1d>,
+			      <0xff000f20 0xa8>,
+			      <0xff100000 0x100000>;
+			reg-names = "parf", "dbi", "elbi", "config";
+			device_type = "pci";
+			linux,pci-domain = <0>;
+			bus-range = <0x00 0xff>;
+			num-lanes = <1>;
+			/*
+			 * 3.10 caps pcie_0_pipe_clk at 125 MHz, so this RC is
+			 * Gen1 only. Say so: otherwise the DWC advertises Gen2
+			 * in LNKCAP and pci_device_add() tries, and fails, to
+			 * retrain the link up to 5.0 GT/s before the
+			 * downstream bus is scanned.
+			 */
+			max-link-speed = <1>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x01000000 0x0 0x0 0xff200000 0x0 0x100000>,
+				 <0x02000000 0x0 0xff300000 0xff300000 0x0 0xd00000>;
+			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "msi";
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 0x7>;
+			interrupt-map = <0 0 0 1 &intc GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 2 &intc GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 3 &intc GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 4 &intc GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&gcc GCC_PCIE_0_AUX_CLK>,
+				 <&gcc GCC_PCIE_0_CFG_AHB_CLK>,
+				 <&gcc GCC_PCIE_0_MSTR_AXI_CLK>,
+				 <&gcc GCC_PCIE_0_SLV_AXI_CLK>;
+			clock-names = "aux", "cfg", "bus_master", "bus_slave";
+			power-domains = <&gcc PCIE_0_GDSC>;
+			phys = <&pciephy0>;
+			phy-names = "pciephy";
+			qcom,scm-dev-id = <11>;
+
+			pcie@0 {
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				bus-range = <0x01 0xff>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+			};
+		};
+
+		pcie1: pcie@fc528000 {
+			compatible = "qcom,pcie-msm8994";
+			status = "disabled";
+			reg = <0xfc528000 0x2000>,
+			      <0xf8800000 0xf1d>,
+			      <0xf8800f20 0xa8>,
+			      <0xf8801000 0x7f000>;
+			reg-names = "parf", "dbi", "elbi", "config";
+			device_type = "pci";
+			linux,pci-domain = <1>;
+			bus-range = <0x00 0xff>;
+			num-lanes = <1>;
+			/*
+			 * 3.10 caps pcie_1_pipe_clk at 125 MHz, so this RC is
+			 * Gen1 only. Say so: otherwise the DWC advertises Gen2
+			 * in LNKCAP and pci_device_add() tries, and fails, to
+			 * retrain the link up to 5.0 GT/s before the
+			 * downstream bus is scanned.
+			 */
+			max-link-speed = <1>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x01000000 0x0 0x0 0xf8880000 0x0 0x80000>,
+				 <0x02000000 0x0 0xf8900000 0xf8900000 0x0 0x700000>;
+			interrupts = <GIC_SPI 271 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "msi";
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 0x7>;
+			interrupt-map = <0 0 0 1 &intc GIC_SPI 272 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 2 &intc GIC_SPI 273 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 3 &intc GIC_SPI 274 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 4 &intc GIC_SPI 275 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&gcc GCC_PCIE_1_AUX_CLK>,
+				 <&gcc GCC_PCIE_1_CFG_AHB_CLK>,
+				 <&gcc GCC_PCIE_1_MSTR_AXI_CLK>,
+				 <&gcc GCC_PCIE_1_SLV_AXI_CLK>;
+			clock-names = "aux", "cfg", "bus_master", "bus_slave";
+			power-domains = <&gcc PCIE_1_GDSC>;
+			/*
+			 * Do NOT add `interconnects` here. Attempted
+			 * 2026-09-13 (testNP): the vendor stack does vote
+			 * these paths (PEP lists ICBID_MASTER_PCIE_1,
+			 * ICBID_SLAVE_PCIE_1, ICBID_SLAVE_PCIE_1_CFG,
+			 * ICBID_SLAVE_PCIE_PARF; 3.10 votes
+			 * MSM_BUS_MASTER_PCIE_1 -> EBI_CH0 500/800 KBps),
+			 * and the ids to use are SNOC_MAS_PCIE_1 +
+			 * BIMC_SLV_EBI_CH0 ("pcie-mem") and
+			 * BIMC_MAS_AMPSS_M0 + CNOC_SLV_PCIE_1_CFG
+			 * ("cpu-pcie") - but wiring them makes the RC never
+			 * probe: the qnoc providers report
+			 * "sync_state() pending due to fc528000.pcie" while
+			 * the PCIe node defers on those same providers, so
+			 * fw_devlink holds it with no `driver` bound and
+			 * nothing in devices_deferred. Revisit only with a
+			 * fw_devlink=permissive style workaround, and only
+			 * once the endpoint actually enumerates - the vote
+			 * is needed for PCIe DMA, not for config access.
+			 *
+			 * 2026-09-16 (testR7): retried with fw_devlink=permissive
+			 * after the Cityman XL DSDT WlanD0ResourceVote confirmed
+			 * Windows DOES vote ICBID_MASTER_APPSS_PROC->
+			 * ICBID_SLAVE_PCIE_1_CFG. Result: it now HANGS (black
+			 * screen, USB up briefly then gone, camera-reboot dead) -
+			 * the WIP msm8994 icc driver can't handle the
+			 * BIMC->CNOC cross-provider path. And the link already
+			 * trains without it, so config TLPs are already issued:
+			 * this vote is bandwidth/DMA, not the enumeration gate.
+			 */
+			qcom,scm-dev-id = <12>;
+
+			/*
+			 * Endpoint properties belong on the port node, not the
+			 * Root Complex: qcom_pcie_parse_port() reads `phys` and
+			 * `reset-gpios` from here and qcom_pcie_parse_perst()
+			 * warns "Reusing PERST# from Root Complex node. DT needs
+			 * to be fixed!" if they sit on the host (Snaccy: pcie1
+			 * "has an endpoint property that it NEEDS downstream").
+			 */
+			pcie@0 {
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				bus-range = <0x01 0xff>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+				phys = <&pciephy1>;
+			};
 		};
 
 		rpm_msg_ram: sram@fc428000 {
@@ -1041,6 +1215,79 @@ sdc2_data_off: sdc2-data-off-state {
 				bias-pull-up;
 				drive-strength = <2>;
 			};
+
+			pcie0_default: pcie0-default-state {
+				perst-pins {
+					pins = "gpio53";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				clkreq-pins {
+					pins = "gpio54";
+					function = "pci_e0";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+
+				wake-pins {
+					pins = "gpio55";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+			};
+
+			pcie1_default: pcie1-default-state {
+				perst-pins {
+					pins = "gpio35";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				clkreq-pins {
+					pins = "gpio36";
+					function = "pci_e1";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+
+				wake-pins {
+					pins = "gpio37";
+					function = "gpio";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+			};
+
+			wlan_en_default: wlan-en-default-state {
+				pins = "gpio113";
+				function = "gpio";
+				drive-strength = <16>;
