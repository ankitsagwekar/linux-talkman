# Reference: <https://postmarketos.org/devicepkg>
maintainer="Ankit <ankits@outlook.sg>"
pkgname=device-microsoft-talkman
pkgdesc="Microsoft Lumia 950"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-firmware-ath10k
	linux-firmware-qca
	linux-postmarketos-qcom-msm8994
	postmarketos-base
	systemd-boot
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	talkman-usb-debug.sh
	talkman-usb-debug.service
	talkman-wifi.sh
	talkman-wifi.service
	talkman-cpufreq.sh
	talkman-cpufreq.service
	talkman-cpufreq.conf
	talkman-venus.conf
	90-talkman-bluetooth-off.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Temporary bring-up aid: dumps USB state to /var/log at boot
	install -Dm755 "$srcdir"/talkman-usb-debug.sh \
		"$pkgdir"/usr/libexec/talkman-usb-debug.sh
	install -Dm644 "$srcdir"/talkman-usb-debug.service \
		"$pkgdir"/usr/lib/systemd/system/talkman-usb-debug.service
	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -s /usr/lib/systemd/system/talkman-usb-debug.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/talkman-usb-debug.service

	# Powers the QCA6174 Wi-Fi chip (PCIe0) once the kernel is up
	install -Dm755 "$srcdir"/talkman-wifi.sh \
		"$pkgdir"/usr/libexec/talkman-wifi.sh
	install -Dm644 "$srcdir"/talkman-wifi.service \
		"$pkgdir"/usr/lib/systemd/system/talkman-wifi.service
	ln -s /usr/lib/systemd/system/talkman-wifi.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/talkman-wifi.service

	# CPU frequency scaling: PARKED. The big (A57) cores still hang the phone
	# soon after scaling starts, so the loader service is installed but not
	# enabled, and the modules never auto-load. Enable by hand to test:
	# systemctl enable talkman-cpufreq (see README).
	install -Dm755 "$srcdir"/talkman-cpufreq.sh \
		"$pkgdir"/usr/libexec/talkman-cpufreq.sh
	install -Dm644 "$srcdir"/talkman-cpufreq.service \
		"$pkgdir"/usr/lib/systemd/system/talkman-cpufreq.service
	install -Dm644 "$srcdir"/talkman-cpufreq.conf \
		"$pkgdir"/etc/modprobe.d/talkman-cpufreq.conf

	# Venus video codec: experimental, not loaded automatically (needs the
	# Lumia firmware qcvss8994.mbn; load by hand, see README)
	install -Dm644 "$srcdir"/talkman-venus.conf \
		"$pkgdir"/etc/modprobe.d/talkman-venus.conf

	# Bluetooth radio off at boot (driver stays loaded: Wi-Fi needs it)
	install -Dm644 "$srcdir"/90-talkman-bluetooth-off.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-talkman-bluetooth-off.rules
}

