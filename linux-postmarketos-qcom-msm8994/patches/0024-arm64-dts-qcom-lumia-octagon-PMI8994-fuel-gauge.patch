From: Claude <noreply@anthropic.com>
Subject: [PATCH] arm64: dts: qcom: lumia-octagon: PMI8994 fuel gauge (talkman)

Add the FG_SOC node on PMI8994, the shared Octagon battery settings and the
Lumia 950 BV-T5E profile (from EpicLPer 197886c0; the talkman battery node
already exists).

---
--- a/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts	2026-11-14 19:49:47.904359070 +0530
+++ b/arch/arm64/boot/dts/qcom/msm8992-msft-lumia-octagon-talkman.dts	2026-11-14 19:49:47.915024865 +0530
@@ -207,3 +207,27 @@
 		};
 	};
 };
+
+/* BV-T5E 3000 mAh fuel gauge profile (EpicLPer, from the Windows driver data) */
+&pmi8994_fg {
+	monitored-battery = <&battery>;
+	qcom,battery-type = "microsoft_bvt5e_3000mah";
+	qcom,fg-profile-data = [
+		E3 83 FA 7C 3B 81 76 77
+		59 83 F5 66 2B 88 9E 8F
+		05 82 B5 9A A3 BD 65 CA
+		55 10 F3 83 3C 7D 63 81
+		BA 77 4F 83 93 6A 48 79
+		51 87 37 82 89 9A 3A BE
+		10 D0 58 0D E3 0B 01 5A
+		14 70 B8 FE BB 44 62 44
+		07 41 00 00 D9 46 07 39
+		FE 12 00 00 00 00 00 00
+		00 00 00 00 83 70 28 6B
+		25 68 1A 81 FE 74 62 63
+		F1 60 00 7B AE 6F 42 60
+		9D 74 FD A2 18 70 61 AE
+		5F A0 71 0C 28 00 FF 36
+		F0 11 30 03 00 00 00 0C
+	];
+};
--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi	2026-11-14 19:49:47.901981066 +0530
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi	2026-11-14 19:49:47.914971033 +0530
@@ -633,6 +633,21 @@
 	};
 };
 
+/* Both OEM packs use a 330 kOhm ID resistor. Profiles are per-device. */
+&pmi8994_fg {
+	qcom,batt-id-kohm = <330>;
+	qcom,batt-id-range-pct = <15>;
+	qcom,thermal-coefficients = [EC 85 76 4A FC 35];
+	qcom,warm-bat-decidegc = <450>;
+	qcom,hot-bat-decidegc = <550>;
+	qcom,cool-bat-decidegc = <(-50)>;
+	qcom,cold-bat-decidegc = <(-100)>;
+	qcom,resume-soc = <99>;
+	qcom,fg-iterm-ma = <200>;
+	qcom,fg-chg-iterm-ma = <100>;
+	qcom,fg-cutoff-voltage-mv = <2800>;
+};
+
 &pmi8994_gpios {
 	pinctrl-0 = <&hd3ss460_amsel &hd3ss460_en>;
 	pinctrl-names = "default";
--- a/arch/arm64/boot/dts/qcom/pmi8994.dtsi	2026-11-14 19:49:47.900006933 +0530
+++ b/arch/arm64/boot/dts/qcom/pmi8994.dtsi	2026-11-14 19:49:47.914858879 +0530
@@ -20,6 +20,11 @@
 			#interrupt-cells = <2>;
 		};
 
+		pmi8994_fg: fuel-gauge@4000 {
+			compatible = "qcom,pmi8994-fg";
+			reg = <0x4000>;
+		};
+
 		pmi8994_smbchg: charger@1000 {
 			compatible = "qcom,pmi8994-smbchg";
 			reg = <0x1000>;
